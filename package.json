{
  "name": "chrome-profile-manager",
  "version": "1.3.9",
  "description": "Calculatory",
  "author": "Calculator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.calculator.app",
    "productName": "Calculatory",
    "asar": false,
    "directories": {
      "output": "dist2"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "executableName": "Calculator",
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Calculator.exe"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.4",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
